<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  App Store entitlements. Separate from entitlements.plist, which is the
  Developer ID / DMG build and is deliberately NOT sandboxed.

  Do not merge the two. The DMG build wants
  `com.apple.security.cs.allow-unsigned-executable-memory` because GStreamer's
  liborc JIT-compiles SIMD kernels into RWX pages; the App Store build must not
  request it, and does not need to, because it plays through AVFoundation
  (src/engine/avf.rs) with no GStreamer in the bundle at all.

  Every entitlement below is here because something in the tree needs it.
  Audit: docs/superpowers/plans/2026-09-01-sandbox-readiness-audit.md
-->
<plist version="1.0">
<dict>
    <!-- Required for the Mac App Store. Not optional, not negotiable. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!-- The user picks music folders through NSOpenPanel; this is what makes
         that grant real. Read-write rather than read-only because CLAUDE.md's
         deletion rule permits deleting a file from the Media Library file view,
         and because the ID3 editor writes tags back. -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- A folder grant has to survive relaunch: a path alone grants nothing in
         a sandbox after restart. The storage side is implemented — `folders`
         carries a `bookmark` column, `add_folder` takes the bookmark at pick
         time, and `restore_folder_access` resolves them at startup. See
         src/sandbox.rs. -->
    <key>com.apple.security.files.bookmarks.app-scope</key>
    <true/>

    <!-- ~/Music without making the user pick it. A music player whose first
         run cannot see the obvious place music lives is a music player that
         looks broken, and this is the entitlement for exactly that case.
         It does not replace the two above: a library kept anywhere else still
         arrives through NSOpenPanel and is held by a bookmark. -->
    <key>com.apple.security.assets.music.read-write</key>
    <true/>

    <!-- Audio CDs and portable players mount under /Volumes. macOS presents an
         audio CD as one AIFF per track on a mounted volume, which is the path
         src/disc/toc.rs already takes. -->
    <key>com.apple.security.files.removable-media.read-write</key>
    <true/>

    <!-- gnudb (CDDB) lookups over plain http, via minreq. Outbound only; the
         app is not a server. -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!--
      NOT REQUESTED, AND ONE OPEN QUESTION.

      Reading CD-TEXT opens the media's raw BSD node (/dev/rdiskN) and issues
      DKIOCCDREADTOC — see src/disc/discrecording.rs. Whether the App Sandbox
      permits opening a raw device node under
      files.removable-media.read-write is NOT established: that entitlement is
      documented for files on removable volumes, and a device node is not a
      file on a volume.

      There is no legal alternative if it is denied. DiscRecording's own
      CD-TEXT reader (DRDeviceReadCDText) is exported but undeclared, and App
      Review treats undeclared symbols as private API. The mounted volume's
      .TOC.plist carries the table of contents, not the CD-TEXT.

      This needs a signed sandboxed build and a disc with CD-TEXT to settle,
      and it is the top open risk for feature parity. Do not add a
      temporary-exception entitlement to paper over it without first measuring
      whether one is needed.
    -->
</dict>
</plist>
