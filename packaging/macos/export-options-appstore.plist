<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Mac App Store export options.

  Separate from export-options.plist, which exports the Developer ID build for
  the DMG. Do not merge them: that one exports an unsigned .app that
  build-dmg.sh ad-hoc signs afterwards, and this one must produce a properly
  signed .pkg with a provisioning profile embedded. The two have nothing in
  common but their file format.

  `app-store-connect` is the current spelling of what older Xcode called
  `app-store`. This tree builds with Xcode 26.
-->
<plist version="1.0">
<dict>
    <key>method</key>
    <string>app-store-connect</string>

    <!-- Josef Schelch. The same team the Developer ID certificates belong to;
         App Store distribution needs different certificates from that team,
         not a different team. -->
    <key>teamID</key>
    <string>HR3P54M383</string>

    <!-- Automatic, which lets Xcode register the App ID and create the
         provisioning profile itself. That is three steps in the developer
         portal replaced by a checkbox, and for a single-maintainer project it
         is the right trade.
         
         An earlier version of this file used manual signing on the argument
         that a build which picks its own profile is one you cannot reproduce.
         That argument is sound and was still the wrong call: the portal is
         where the mistakes happen, and reproducibility is worth less here than
         not having to go there. Switch back to manual if this ever builds
         somewhere other than one person's machine — CI, or a second
         maintainer — where "whatever Xcode chose" stops being knowable.
         
         The Apple Distribution certificate still has to exist. Automatic
         signing selects a certificate; it does not create one. -->
    <key>signingStyle</key>
    <string>automatic</string>
    <key>signingCertificate</key>
    <string>Apple Distribution</string>

    <!-- Symbols go to App Store Connect for crash reports. There is nothing
         secret in them and they are what makes a crash log readable. -->
    <key>uploadSymbols</key>
    <true/>

    <!-- No bitcode on macOS, and it is gone from the toolchain entirely. -->
    <key>stripSwiftSymbols</key>
    <true/>
</dict>
</plist>
